# Private secrets for deployment
# Copy to vars.yml and fill in real values

# Custom Nextcloud image (built via CI, pushed to GHCR)
nextcloud_image: ghcr.io/MArpogaus/nextcloud:dev

# SSH Key path (relative to ansible-base/)
ssh_key_path: "../test/coreos_key"

# GHCR Authentication (for private container images)
ghcr_username: ""
ghcr_token: ""
ghcr_registry: "ghcr.io"

# Nextcloud Admin (for initial setup)
nextcloud_admin_user: "admin"
nextcloud_admin_password: "<generate-strong-password>"

# Database passwords
db_root_password: "<generate-strong-password>"
db_nextcloud_password: "<generate-strong-password>"

# Domain configuration
domain: "cloud.your-domain.de"
trusted_domains:
  - "cloud.your-domain.de"
  - "localhost"

# Backup configuration
backup_destination: "/mnt/backup/nextcloud"
backup_retention_days: 30
