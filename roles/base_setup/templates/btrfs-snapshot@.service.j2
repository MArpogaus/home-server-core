[Unit]
Description=Btrfs read-only snapshot of @%i
{% if base_setup_backup_targets | length > 0 %}
# A finished snapshot is what triggers the off-box sync. systemd merges the
# identical start jobs from each service's snapshot, so each target syncs once.
OnSuccess={% for t in base_setup_backup_targets %}btrfs-backup@{{ t.name }}.service {% endfor %}

{% endif %}

[Service]
Type=oneshot
Environment=BTRFS_SNAPSHOT_DIR={{ base_setup_btrfs_snapshot_dir }}
Environment=BTRFS_SNAPSHOT_RETENTION_DAYS={{ base_setup_btrfs_snapshot_retention_days }}
Environment=BTRFS_SERVICES_DIR={{ base_setup_services_dir }}
ExecStart=/usr/local/bin/btrfs-snapshot-cleanup.sh %i
