variant: fcos
version: 1.7.0
passwd:
  users:
    - name: core
      groups:
        - wheel
      password_hash: "${PASSWORD_HASH}"
      ssh_authorized_keys:
        - "${SSH_PUBLIC_KEY}"
storage:
  filesystems:
    - device: /dev/disk/by-partlabel/root
      wipe_filesystem: true
      format: btrfs
      label: root
  files:
    - path: /etc/pki/containers/secureblue-2025.pub
      mode: 0644
      contents:
        inline: |
          -----BEGIN PUBLIC KEY-----
          MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEdruKsOhUkgdd0lNDHNBymE2Wyb/p
          GVnx59QbNoGFbImqZLRVt6uQnO9MfiHU9IZiJl9aNetfAqDsgsltAUQnXQ==
          -----END PUBLIC KEY-----
    - path: /etc/pki/containers/marpogaus-cosign.pub
      mode: 0644
      contents:
        inline: |
          -----BEGIN PUBLIC KEY-----
          MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE54diWpeKbUOvhecp64Oe5XOB9VHX
          bCvOPDIIzZz0XNJsln4vVsWiHUMU+GIM20/4ohFk0rNx35l41G8+4vdhAQ==
          -----END PUBLIC KEY-----
    # Gates the signed rebase below. securecore's own policy.json replaces
    # this one afterwards, and install_secureblue.sh merges our key into that.
    - path: /etc/containers/policy.json
      mode: 0644
      overwrite: true
      contents:
        inline: |
          {
            "default": [{"type": "reject"}],
            "transports": {
              "docker": {
                "ghcr.io/secureblue": [
                  {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/secureblue-2025.pub",
                    "signedIdentity": {"type": "matchRepository"}
                  }
                ]
              }
            }
          }
    - path: /etc/containers/registries.d/ghcr.io-marpogaus.yaml
      mode: 0644
      contents:
        inline: |
          docker:
            ghcr.io/marpogaus:
              use-sigstore-attachments: true
    - path: /etc/ssh/sshd_config.d/10-no-passwords.conf
      mode: 0644
      contents:
        inline: |
          # Keys only. The console password exists for local recovery; it must
          # not be usable over the network.
          PasswordAuthentication no
          KbdInteractiveAuthentication no
          PermitRootLogin no
    - path: /etc/polkit-1/rules.d/60-run0-fast-user-auth.rules
      mode: 0644
      contents:
        inline: |
          polkit.addRule(function(action, subject) {
            if (action.id === "org.freedesktop.systemd1.manage-units" &&
                subject.user === "core" &&
                subject.isInGroup("wheel")) {
              return polkit.Result.YES;
            }
          });
    - path: /opt/install_secureblue.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -e

          systemctl disable --now zincati.service 2>/dev/null || true
          systemctl stop rpm-ostreed-automatic.timer rpm-ostreed-automatic.service 2>/dev/null || true

          echo 'Rebasing to securecore (SecureBlue CoreOS image)...'
          # set -e aborts the script if this fails, so there is no status check.
          rpm-ostree rebase ostree-image-signed:docker://ghcr.io/secureblue/securecore-main-hardened:latest

          # securecore ships its own policy.json; add our signing key to it.
          cp /usr/etc/containers/policy.json /etc/containers/policy.json
          policy_tmp="$(mktemp)"
          jq --arg image_registry "ghcr.io/marpogaus" \
              '.transports.docker |=
              { $image_registry: [
                  {
                      "type": "sigstoreSigned",
                      "keyPath": "/etc/pki/containers/marpogaus-cosign.pub",
                      "signedIdentity": {
                          "type": "matchRepository"
                      }
                  }
              ] } + .' /etc/containers/policy.json > "${policy_tmp}"
          cp "${policy_tmp}" /etc/containers/policy.json
          rm -f "${policy_tmp}"

          rm -f /opt/install_secureblue.sh /etc/pki/containers/secureblue-2025.pub

          echo 'Rebooting...'
          sleep 5
          systemctl reboot
systemd:
  units:
    - name: install-secureblue.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebase to SecureBlue on the first boot
        ConditionPathExists=/opt/install_secureblue.sh
        Wants=network-online.target
        After=network-online.target

        [Service]
        Type=oneshot
        WorkingDirectory=/var/tmp
        ExecStart=/opt/install_secureblue.sh

        [Install]
        WantedBy=multi-user.target
    - name: qemu-guest-agent.service
      enabled: true
