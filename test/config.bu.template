variant: fcos
version: 1.7.0
passwd:
  users:
    - name: core
      groups:
        - wheel
      password_hash: "${PASSWORD_HASH}"
      ssh_authorized_keys:
        - "${SSH_PUBLIC_KEY}"
storage:
  filesystems:
    - device: /dev/disk/by-partlabel/root
      wipe_filesystem: true
      format: btrfs
      label: root
  files:
    - path: /etc/pki/containers/secureblue-2025.pub
      mode: 0644
      contents:
        inline: |
          -----BEGIN PUBLIC KEY-----
          MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEdruKsOhUkgdd0lNDHNBymE2Wyb/p
          GVnx59QbNoGFbImqZLRVt6uQnO9MfiHU9IZiJl9aNetfAqDsgsltAUQnXQ==
          -----END PUBLIC KEY-----
    - path: /etc/pki/containers/marpogaus-cosign.pub
      mode: 0644
      contents:
        inline: |
          -----BEGIN PUBLIC KEY-----
          MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE54diWpeKbUOvhecp64Oe5XOB9VHX
          bCvOPDIIzZz0XNJsln4vVsWiHUMU+GIM20/4ohFk0rNx35l41G8+4vdhAQ==
          -----END PUBLIC KEY-----
    - path: /etc/containers/policy.json
      mode: 0644
      overwrite: true
      contents:
        inline: |
          {
            "default": [{"type": "reject"}],
            "transports": {
              "docker": {
                "ghcr.io/secureblue": [
                  {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/secureblue-2025.pub",
                    "signedIdentity": {"type": "matchRepository"}
                  }
                ]
              }
            }
          }
    - path: /etc/containers/registries.d/ghcr.io-marpogaus.yaml
      mode: 0644
      contents:
        inline: |
          docker:
            ghcr.io/marpogaus:
              use-sigstore-attachments: true
    - path: /etc/polkit-1/rules.d/60-run0-fast-user-auth.rules
      mode: 0644
      contents:
        inline: |
          polkit.addRule(function(action, subject) {
            if (action.id.indexOf("org.freedesktop.") === 0 &&
                subject.isInGroup("wheel")) {
              return polkit.Result.YES;
            }
          });
    - path: /var/home/core/disable-userns.sh
      mode: 0755
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          #!/usr/bin/env bash
          # SecureBlue ships the userns hardening module enabled; rootless Podman
          # needs it off. Runs once on the first login after the rebase reboot.
          set -euo pipefail
          ujust set-container-userns on
          sed -i '/disable-userns.sh/d' /var/home/core/.bash_profile
          rm -f /var/home/core/disable-userns.sh
    - path: /opt/install_secureblue.sh
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -e

          sudo systemctl disable --now zincati.service 2>/dev/null || true
          sudo systemctl stop rpm-ostreed-automatic.timer rpm-ostreed-automatic.service 2>/dev/null || true

          echo 'Rebasing to securecore (SecureBlue CoreOS image)...'
          # set -e aborts the script if this fails, so there is no status check.
          sudo rpm-ostree rebase ostree-image-signed:docker://ghcr.io/secureblue/securecore-main-hardened:latest

          # securecore ships its own policy.json; add our signing key to it.
          sudo cp /usr/etc/containers/policy.json /etc/containers/policy.json
          jq --arg image_registry "ghcr.io/marpogaus" \
              '.transports.docker |=
              { $image_registry: [
                  {
                      "type": "sigstoreSigned",
                      "keyPath": "/etc/pki/containers/marpogaus-cosign.pub",
                      "signedIdentity": {
                          "type": "matchRepository"
                      }
                  }
              ] } + .' /etc/containers/policy.json > POLICY.tmp
          sudo cp POLICY.tmp /etc/containers/policy.json
          sudo rm POLICY.tmp

          # Runs on the next login after the reboot (deployed by Ignition below)
          echo '/var/home/core/disable-userns.sh' >> /var/home/core/.bash_profile

          sudo sed -i -e '/\/opt\/install_secureblue.sh/d' /var/home/core/.bash_profile
          sudo rm -f /opt/install_secureblue.sh /etc/pki/containers/secureblue-2025.pub

          echo 'Rebooting...'
          sleep 5
          sudo systemctl reboot
    - path: /var/home/core/.bash_profile
      overwrite: false
      user:
        name: core
      group:
        name: core
      append:
        - inline: |
            /opt/install_secureblue.sh
systemd:
  units:
    - name: qemu-guest-agent.service
      enabled: true
